<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bjitgroup.training</groupId>
    <artifactId>playwright-java-training</artifactId>
    <version>1.0.0</version>
    <name>playwright-java-training</name>
    <description>Demo code, lab exercises and solutions for the BJIT Playwright with Java course.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Keep this version in sync with the Docker image tag used on days 16-20
             (mcr.microsoft.com/playwright/java:v1.62.0-noble). -->
        <playwright.version>1.62.0</playwright.version>
        <testng.version>7.11.0</testng.version>

        <!-- Which TestNG suite "mvn test" runs. Override per day:
             mvn test -Dsuite=src/test/resources/suites/day01.xml -->
        <suite>src/test/resources/suites/day01.xml</suite>
    </properties>

    <dependencies>
        <!-- Compile scope (not test) so the Playwright CLI can be started with exec:java
             to install browsers. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Ignored when you pass -Dtest=SomeClass, which runs that class only. -->
                    <suiteXmlFiles>
                        <suiteXmlFile>${suite}</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

            <!-- Playwright CLI: mvn exec:java -Dexec.args="install" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.microsoft.playwright.CLI</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
